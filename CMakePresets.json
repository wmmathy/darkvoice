{
  "version": 5,
  "cmakeMinimumRequired": {"major": 3, "minor": 24, "patch": 0},
  "configurePresets": [
    {
      "name": "debug",
      "displayName": "Debug core tests",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": {"CMAKE_BUILD_TYPE": "Debug", "BUILD_TESTING": "ON"}
    },
    {
      "name": "release",
      "inherits": "debug",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {"CMAKE_BUILD_TYPE": "Release"}
    },
    {
      "name": "sanitizers",
      "inherits": "debug",
      "binaryDir": "${sourceDir}/build/sanitizers",
      "cacheVariables": {"DARKVOICE_ENABLE_SANITIZERS": "ON"}
    }
  ],
  "buildPresets": [
    {"name": "debug", "configurePreset": "debug", "jobs": 2},
    {"name": "release", "configurePreset": "release", "jobs": 2},
    {"name": "sanitizers", "configurePreset": "sanitizers", "jobs": 2}
  ],
  "testPresets": [
    {"name": "debug", "configurePreset": "debug", "output": {"outputOnFailure": true}, "execution": {"noTestsAction": "error"}},
    {"name": "release", "configurePreset": "release", "output": {"outputOnFailure": true}, "execution": {"noTestsAction": "error"}},
    {"name": "sanitizers", "configurePreset": "sanitizers", "output": {"outputOnFailure": true}, "execution": {"noTestsAction": "error"}}
  ]
}
